{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.351",
        "barryvdh/laravel-dompdf": "^3.1.0",
        "google/apiclient": "*",
        "guzzlehttp/guzzle": "^7.4",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "laravel/ui": "^4.0",
        "league/csv": "^9.8",
        "league/flysystem-aws-s3-v3": "3.29.0",
        "maatwebsite/excel": "^3.1",
        "pusher/pusher-php-server": "^7.2",
        "spatie/laravel-sitemap": "^8.0",
        "stripe/stripe-php": "^10.5",
        "tymon/jwt-auth": "^2.3",
        "vonage/client": "4.2.0",
        "xeroapi/xero-php-oauth2": "^2.13"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "app/MyHelpers.php",
            "app/Helper/functions.php",
            "app/Helper/general.php",
            "app/Helper/app_helper.php",
            "app/Helper/nexmo.php",
            "app/Helper/my_gallery.php",
            "app/Helper/filesystem.php",
            "app/Helper/admin.php",
            "app/Helper/resume_helper.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
